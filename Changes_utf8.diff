diff --git a/Assets/01_Scripts/Exploration/System/ExplorationFogLogic.shader b/Assets/01_Scripts/Exploration/System/ExplorationFogLogic.shader
new file mode 100644
index 00000000..f3b165c7
--- /dev/null
+++ b/Assets/01_Scripts/Exploration/System/ExplorationFogLogic.shader
@@ -0,0 +1,81 @@
+Shader "Custom/ExplorationFogLogic"
+{
+    Properties
+    {
+        _MainTex ("History", 2D) = "black" {}
+    }
+    SubShader
+    {
+        Tags { "RenderType"="Opaque" }
+        LOD 100
+        ZTest Always Cull Off ZWrite Off
+
+        Pass
+        {
+            CGPROGRAM
+            #pragma vertex vert
+            #pragma fragment frag
+            #include "UnityCG.cginc"
+
+            struct appdata {
+                float4 vertex : POSITION;
+                float2 uv : TEXCOORD0;
+            };
+
+            struct v2f {
+                float2 uv : TEXCOORD0;
+                float4 vertex : SV_POSITION;
+            };
+
+            sampler2D _MainTex;
+
+            float4 _PlayerPos;
+            float4 _MapSize;
+            float4 _MapOrigin;
+            float _ClearRadius;
+            float _DarkenSpeed;
+            float4 _UVMult;
+
+            v2f vert(appdata v) {
+                v2f o;
+                o.vertex = UnityObjectToClipPos(v.vertex);
+                o.uv = v.uv;
+                return o;
+            }
+
+            fixed4 frag(v2f i) : SV_Target {
+                // ?댁쟾 ?꾨젅?꾩쓽 ?덇컻 ?곹깭 ?섑뵆留?(RenderTexture Blit ?곗궛??UV 洹몃?濡??ъ슜)
+                // RenderTextureFormat.R8 ???ъ슜?섎?濡?r 梨꾨꼸??媛믪씠 ??λ맖
+                float historyVal = tex2D(_MainTex, i.uv).r;
+
+                // 以묒떖?먯쓣 0,0?쇰줈 留욎땄 (-0.5 ~ 0.5)
+                float2 uvCentered = i.uv - 0.5;
+
+                // 諛⑺뼢 蹂댁젙 (Manager?먯꽌 ?섍꺼以 flip ?곸슜)
+                if (_UVMult.x < 0) uvCentered.x = -uvCentered.x;
+                // Unity Plane??湲곕낯 ?뚯쟾 ?뱀꽦 怨좊젮
+                if (_UVMult.y < 0) uvCentered.y = -uvCentered.y;
+                else uvCentered.y = -uvCentered.y; // Plane??濡쒖뺄 Z媛 諛섎?瑜??ν븯??寃쎌슦媛 留롮쓬
+
+                float2 mapWorldPos = _MapOrigin.xy + uvCentered * _MapSize.xy;
+
+                // ?뚮젅?댁뼱? 嫄곕━ 痢≪젙
+                float dist = distance(mapWorldPos, _PlayerPos.xy);
+
+                // ?쒖빞 諛섍꼍 ?댁뿉???대━??(1??媛源뚯슱?섎줉 諛앹쓬/?щ챸??
+                // 嫄곕━媛 ClearRadius蹂대떎 ?묒쑝硫?1, 硫?댁쭏?섎줉 0?쇰줈 ?⑥뼱吏?+                float currentClear = 1.0 - saturate(dist / _ClearRadius);
+
+                // ?댁쟾 ??궗?먯꽌 ?꾨젅?꾨떦 ?쇱젙??_DarkenSpeed)??類?(?쒖꽌???대몢?뚯쭚)
+                float fadedHistory = saturate(historyVal - _DarkenSpeed);
+
+                // ?꾩옱 ?뚮젅?댁뼱 ?꾩튂??諛앷린(currentClear)? ?쒖꽌??吏?뚯???怨쇨굅 諛앷린(fadedHistory) 以?理쒕?媛??좎?
+                float finalClear = max(fadedHistory, currentClear);
+
+                // ?⑥씪 梨꾨꼸 R8 ?대?濡??몄쓽??RGB 紐⑤몢 ?좊떦
+                return fixed4(finalClear, finalClear, finalClear, 1.0);
+            }
+            ENDCG
+        }
+    }
+}
