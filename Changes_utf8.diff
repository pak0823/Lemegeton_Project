diff --git a/Assets/01_Scripts/Exploration/System/ExplorationFogDisplay.shader b/Assets/01_Scripts/Exploration/System/ExplorationFogDisplay.shader
new file mode 100644
index 00000000..7f667f86
--- /dev/null
+++ b/Assets/01_Scripts/Exploration/System/ExplorationFogDisplay.shader
@@ -0,0 +1,60 @@
+Shader "Custom/ExplorationFogDisplay"
+{
+    Properties
+    {
+        _MainTex ("Fog Mask Texture", 2D) = "black" {}
+        _FogColor ("Fog Color", Color) = (0, 0, 0, 1)
+        _FogSensitivity ("Fog Light Output", Float) = 1.0
+    }
+    SubShader
+    {
+        Tags { "Queue"="Transparent" "IgnoreProjector"="True" "RenderType"="Transparent" }
+        Blend SrcAlpha OneMinusSrcAlpha
+        LOD 100
+        Cull Off
+        ZWrite Off
+
+        Pass
+        {
+            CGPROGRAM
+            #pragma vertex vert
+            #pragma fragment frag
+            #include "UnityCG.cginc"
+
+            struct appdata {
+                float4 vertex : POSITION;
+                float2 uv : TEXCOORD0;
+            };
+
+            struct v2f {
+                float2 uv : TEXCOORD0;
+                float4 vertex : SV_POSITION;
+            };
+
+            sampler2D _MainTex;
+            float4 _MainTex_ST;
+            fixed4 _FogColor;
+            float _FogSensitivity;
+
+            v2f vert(appdata v) {
+                v2f o;
+                o.vertex = UnityObjectToClipPos(v.vertex);
+                o.uv = TRANSFORM_TEX(v.uv, _MainTex);
+                return o;
+            }
+
+            fixed4 frag(v2f i) : SV_Target {
+                // R 梨꾨꼸??媛믪씠 ?믪쓣?섎줉 諛앹쓬(?щ챸??= 鍮?援щ찉)
+                fixed4 maskCol = tex2D(_MainTex, i.uv);
+
+                float clearAmount = saturate(maskCol.r * _FogSensitivity);
+
+                // ?덇컻??諛섎?濡??щ챸??怨녹씠 ?щ챸?댁빞 ?섎?濡?(1 - 諛앷린)瑜??щ챸?꾨줈 ?
+                float fogAlpha = 1.0 - clearAmount;
+
+                return fixed4(_FogColor.rgb, _FogColor.a * fogAlpha);
+            }
+            ENDCG
+        }
+    }
+}
